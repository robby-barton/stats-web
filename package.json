{
  "private": true,
  "packageManager": "yarn@1.22.19",
  "engines": {
    "npm": ">=11.0.0 <12.0.0",
    "node": ">=24.13.0 <25.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "build:assets": "vite build",
    "build:11ty": "eleventy",
    "build:eleventy": "yarn build:assets && yarn build:11ty",
    "dev:assets": "vite build --watch",
    "dev:sync": "chokidar \"src/assets/build/**/*\" -c \"node -e \\\"require('fs').writeFileSync('src/_data/.assets-stamp', Date.now().toString())\\\"\"",
    "dev:eleventy": "concurrently -k \"yarn dev:assets\" \"yarn dev:sync\" \"yarn dev:11ty\"",
    "dev:11ty": "eleventy --serve",
    "clean": "rm -rf _site src/assets/build",
    "dev": "yarn clean && yarn build:assets && yarn dev:eleventy",
    "build": "yarn clean && yarn build:eleventy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint-language-service": "^5.0.5",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
